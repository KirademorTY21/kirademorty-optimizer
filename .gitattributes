# Normalize line endings on commit so the build is reproducible on Windows.
* text=auto

*.cs   text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.manifest text eol=crlf

*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

*.png binary
*.ico binary
*.exe binary
*.dll binary
